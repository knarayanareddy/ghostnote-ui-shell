# Public Supabase project URL (Project Settings → API → Project URL).
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Publishable / anon key. This key is shipped to the browser, so it is not a
# secret — but it is a write credential against your database. Row level
# security is what protects the data (see supabase/migrations/).
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
